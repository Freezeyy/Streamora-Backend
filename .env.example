NODE_ENV=test
PROJECT_JWT_SECRET=top_secret
APPLICATION_DEBUG=false
PORT=3000
APP_URL=http://localhost:3000

DATABASE_USERNAME=root
DATABASE_PASSWORD=yourpasswd
DATABASE_HOST=localhost
DATABASE_NAME=dummy
DATABASE_PORT=3306
DATABASE_ENGINE=mysql

# Folder on disk for uploaded images, videos, and documents.
# Use an absolute path outside the git repo, e.g.:
#   macOS:   /Users/you/.snow/uploads
#   Linux:   /var/lib/snow/uploads
# If unset, defaults to ~/.snow/uploads
STORAGE_ABSOLUTE_PATH=/Users/you/.snow/uploads

MAIL_HOST=mail.domain.my
MAIL_USERNAME=noreply-mail@mail.my
MAIL_PASSWORD=passwordmail
MAIL_PORT=465

# WhatsApp chatbot events API (your whatsapp_bot project)
CHATBOT_API_URL=https://chatbot.4fource.com

# Shown in Settings / Calendar when guiding users to add the bot
WHATSAPP_BOT_NUMBER=+60123456789
WHATSAPP_BOT_DISPLAY=SNOW Events Bot